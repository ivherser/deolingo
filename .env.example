# Docker local: ambas variables usan la misma URL en localhost:5432.
# Supabase: DATABASE_URL usa el pooler de transacciones en 6543 y ?pgbouncer=true&connection_limit=1.
DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/<DB>?schema=public"
# Supabase: DIRECT_URL usa el pooler de sesión en 5432; para Docker local, repite DATABASE_URL.
DIRECT_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/<DB>?schema=public"
# Genera el secreto con openssl rand -base64 32.
NEXTAUTH_SECRET="<genera-uno-con: openssl rand -base64 32>"
NEXTAUTH_URL="http://localhost:3000"
# Correos separados por comas con acceso a /admin.
ADMIN_EMAILS=""
