generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExerciseType {
  TRANSLATE_DE_ES
  TRANSLATE_ES_DE
  MULTIPLE_CHOICE
  WORD_ORDER
  FILL_BLANK
  MATCH_PAIRS
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  name         String
  passwordHash String
  createdAt    DateTime            @default(now())
  progress     UserProgress?
  completions  LessonCompletion[]
  vocabReviews VocabularyReview[]
}

model UserProgress {
  id               String    @id @default(cuid())
  userId           String    @unique
  xp               Int       @default(0)
  streak            Int       @default(0)
  longestStreak     Int       @default(0)
  hearts            Int       @default(5)
  heartsUpdatedAt   DateTime  @default(now())
  lastActivityDate  DateTime?
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LessonCompletion {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  bestScore      Int
  timesCompleted Int      @default(1)
  completedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Unit {
  id          String   @id
  order       Int      @unique
  title       String
  description String
  color       String
  cefrLevel   String   @default("A1")
  lessons     Lesson[]
}

model Lesson {
  id           String            @id
  unitId       String
  order        Int
  title        String
  description  String
  xpReward     Int               @default(10)
  unit         Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  exercises    Exercise[]
  completions  LessonCompletion[]

  @@unique([unitId, order])
}

model GrammarTopic {
  id          String     @id
  slug        String     @unique
  title       String
  summary     String
  explanation String     @db.Text
  order       Int        @unique
  cefrLevel   String     @default("A1")
  exercises   Exercise[]
}

model Exercise {
  id            String        @id
  lessonId      String?
  grammarTopicId String?
  order         Int
  type          ExerciseType
  prompt        String
  data          Json
  answer        Json
  explanation   String?
  lesson        Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  grammarTopic  GrammarTopic? @relation(fields: [grammarTopicId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([grammarTopicId])
}

model VocabularyItem {
  id         String             @id
  german     String
  spanish    String
  article    String?
  plural     String?
  topic      String
  exampleDe  String?
  exampleEs  String?
  reviews    VocabularyReview[]

  @@unique([german, topic])
  @@index([topic])
}

model VocabularyReview {
  id               String         @id @default(cuid())
  userId           String
  vocabularyItemId String
  easeFactor       Float          @default(2.5)
  interval         Int            @default(0)
  repetitions      Int            @default(0)
  nextReviewAt     DateTime
  lastReviewedAt   DateTime?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyItem   VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyItemId])
  @@index([userId, nextReviewAt])
}
